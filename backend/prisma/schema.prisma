// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  doctor
  patient
}

enum AppointmentStatus {
  Waiting
  InProgress
  Completed
  Cancelled
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String? // null za korisnike koji su se prijavili isključivo preko Google OAuth-a
  role      Role     @default(patient)
  createdAt DateTime @default(now())

  // termini na kojima je korisnik pacijent
  appointments       Appointment[]   @relation("PatientAppointments")
  // termini koje je korisnik (doktor) primio/pregledao
  doctorAppointments Appointment[]   @relation("DoctorAppointments")
  // ljekarski izvještaji koje je doktor napisao
  medicalReports     MedicalReport[]
}

model Appointment {
  id        Int               @id @default(autoincrement())
  title     String            @default("Pregled")
  status    AppointmentStatus @default(Waiting)

  userId    Int
  user      User              @relation("PatientAppointments", fields: [userId], references: [id], onDelete: Cascade)

  // doktor koji je primio pacijenta (postavlja se pri "start" pregleda)
  doctorId  Int?
  doctor    User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])

  date      DateTime
  createdAt DateTime          @default(now())

  // ljekarski izvještaj nastao nakon završenog pregleda (1:1)
  report    MedicalReport?

  // kontrolni pregled zakazan nakon ovog (samo-referenca)
  nextAppointmentId Int?         @unique
  nextAppointment   Appointment? @relation("AppointmentFollowUp", fields: [nextAppointmentId], references: [id])
  previousAppointment Appointment? @relation("AppointmentFollowUp")
}

// MKB-10 šifarnik bolesti
model Diagnosis {
  id        Int      @id @default(autoincrement())
  code      String   @unique // npr. "I10"
  name      String   // npr. "Esencijalna hipertenzija"
  createdAt DateTime @default(now())

  reports MedicalReportDiagnosis[]
}

// Ljekarski izvještaj - nastaje kad doktor završi pregled
model MedicalReport {
  id            Int         @id @default(autoincrement())

  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  doctorId      Int
  doctor        User        @relation(fields: [doctorId], references: [id])

  note          String? // terapija / napomena ljekara
  createdAt     DateTime    @default(now())

  diagnoses MedicalReportDiagnosis[]
}

// M:N veza izvještaj <-> dijagnoze (jedan pregled može imati vise dijagnoza)
model MedicalReportDiagnosis {
  reportId    Int
  diagnosisId Int

  report    MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  diagnosis Diagnosis     @relation(fields: [diagnosisId], references: [id])

  @@id([reportId, diagnosisId])
}